# ==============================================================================
# HOME ACADEMY — PRODUCTION & NETLIFY ENVIRONMENT CONFIGURATION
# ==============================================================================
# Never commit the actual .env file or production secrets to source control.
# Configure these variables in the Netlify Dashboard:
# Site settings > Environment variables
# ==============================================================================

# Application Environment ('production' or 'development')
NODE_ENV=production

# Server Port (Used by standalone Node.js server or Docker)
PORT=3000

# Persistent Database File Path (Used in persistent server environments)
# Default: ./data/home_academy.db
DATABASE_PATH=./data/home_academy.db

# Cloud Database URL for Serverless / Netlify Persistence:
# To maintain a single shared persistent database across Netlify Serverless Function cold starts:
# Option A: Turso LibSQL SQLite (https://turso.tech)
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-turso-jwt-auth-token

# Option B: Standard PostgreSQL / Neon / Supabase Connection URI
# DATABASE_URL=postgresql://user:password@ep-host.pooler.region.neon.tech/dbname?sslmode=require

# Option C: Dedicated Backend API Proxy (If running backend on Render/Railway/Fly)
# API_PROXY_URL=https://api.your-home-academy-server.com

# Cryptographic Secret for Bearer Token Signing & Verification
AUTH_SECRET=ha_production_super_secret_key_change_in_production_2026

# Teacher / Admin Initial Credentials (Salted SHA-256 Hash is generated automatically)
# Default initial password: pakistan786
INITIAL_CLASS_CODE=HOME-ENGLISH
INITIAL_TEACHER_NAME="Sir Zubair"
INITIAL_CLASS_NAME="Home Academy - English Language Program"
